{
  "name": "procureproof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run.mjs --dev",
    "build": "next build --webpack",
    "start": "node scripts/run.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "worker": "tsx --env-file-if-exists=.env.local scripts/worker.ts",
    "examples": "tsx scripts/generate-examples.ts",
    "preview:theme": "node scripts/preview-theme.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/canvas": "^0.1.100",
    "@pdf-lib/fontkit": "^1.1.1",
    "ag-grid-community": "^34.3.0",
    "ag-grid-react": "^34.3.0",
    "better-sqlite3": "^12.4.0",
    "core-js": "^3.51.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "unpdf": "^1.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
