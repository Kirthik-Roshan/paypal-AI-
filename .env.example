# Local setup: copy to .env.local. Never commit actual credentials.
APP_URL=http://localhost:3000
# Set APP_URL to the deployed public HTTPS origin for supplier email links.
# Resend: verify a sender domain; EMAIL_FROM must belong to it.
RESEND_API_KEY=
EMAIL_FROM=
# Choose gmail to send through an authorized Gmail mailbox over HTTPS.
EMAIL_PROVIDER=resend
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
# Must match the browser-facing origin and GitHub OAuth callback registration.
AUTH_URL=http://localhost:3000
WORKSPACE_NAME=My procurement workspace
DATABASE_PATH=./data/procureproof.db
# Required in production; use separate random values of at least 32 characters.
SESSION_SECRET=
AUTH_SECRET=

# Auth.js GitHub OAuth. Connected sandbox requires an allowlisted owner.
# Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_OWNER_GITHUB_LOGINS=

# Dedicated SUPPLIER sandbox business app, separate from buyer test account.
# Only https://api-m.sandbox.paypal.com is used. Production is not enabled.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Actual Tavily Search API. No search calls happen in sample mode.
TAVILY_API_KEY=

# Request chatbot: OpenAI structured intake and private PDF/image understanding.
OPENAI_API_KEY=
# Use a Responses API model with structured outputs and image/PDF support available to your account.
OPENAI_INTAKE_MODEL=
# Enable only on a private local instance; hosted use requires connected owner sign-in.
LOCAL_AI_ENABLED=true

# Legacy intake settings (retained for existing records; the Requests page uses OpenAI).
# Pick a model available in your Gemini account (e.g. gemini-2.5-flash).
# Without both values, the explicitly labelled local text parser remains available.
GEMINI_API_KEY=
GEMINI_INTAKE_MODEL=
# Enable only for a private local hackathon instance; connected owner is otherwise required.
DEMO_LOCAL_AI_ENABLED=false

# Google Places API (New): enable billing and restrict this server-side key.
GOOGLE_PLACES_API_KEY=

# Sarvam Voice Agents: normal Requests supports consenting, allowlisted calls.
# Create input variables procurement_brief and supplier_name in the agent dashboard.
# English prompt and setup: docs/SARVAM_AGENT_PROMPT.md and docs/SARVAM_SETUP.md.
# Verify the agent and destination in Sarvam before enabling it. No automatic retries.
SARVAM_API_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_CONNECTION_ID=
SARVAM_AGENT_PHONE=
SARVAM_ALLOWED_NUMBERS=
SARVAM_APP_VERSION=1
SARVAM_DEMO_AGENT_VERIFIED=false

# Reserved; external retrieval adapter and multimodal analysis are deferred.
ELASTIC_URL=
ELASTIC_API_KEY=
